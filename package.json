{
  "name": "@gcmdev/affected-node-test",
  "version": "0.1.0",
  "description": "Affected-test selection for Node's native test runner",
  "author": "Adrian Browning",
  "license": "MIT",
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist",
    "schema",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianbrowning/affected-node-test.git"
  },
  "bugs": {
    "url": "https://github.com/adrianbrowning/affected-node-test/issues"
  },
  "homepage": "https://github.com/adrianbrowning/affected-node-test#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "affected-tests",
    "node-test",
    "test-selection"
  ],
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "affected-node-test": "./dist/bin/affected-node-test.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/bin/affected-node-test.js', 0o755)\"",
    "check:full": "pnpm docs:check && pnpm typecheck && pnpm build && pnpm test",
    "docs:check": "mdcode update --quiet --check README.md",
    "docs:update": "mdcode update --quiet --apply README.md",
    "prepack": "pnpm build",
    "review:performance": "pnpm build && node scripts/release-benchmark.ts",
    "test": "node --test test/*.test.ts",
    "test:affected": "node bin/affected-node-test.ts affected",
    "test:baseline": "node bin/affected-node-test.ts baseline",
    "test:since-last-run": "node bin/affected-node-test.ts since-last-run",
    "test:watch": "node bin/affected-node-test.ts watch",
    "test:unit": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "acorn": "8.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "mdcode-ts": "0.1.0",
    "typescript": "5.9.3"
  }
}
