{
  "name": "affected-node-test",
  "version": "0.1.0",
  "description": "Affected-test selection for Node's native test runner",
  "type": "module",
  "files": [
    "bin",
    "schema",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianbrowning/affected-node-test.git"
  },
  "bugs": {
    "url": "https://github.com/adrianbrowning/affected-node-test/issues"
  },
  "homepage": "https://github.com/adrianbrowning/affected-node-test#readme",
  "keywords": [
    "affected-tests",
    "node-test",
    "test-selection"
  ],
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "affected-node-test": "./bin/affected-node-test.mjs"
  },
  "scripts": {
    "check:full": "pnpm docs:check && pnpm test",
    "docs:check": "mdcode update --quiet --check README.md",
    "docs:update": "mdcode update --quiet --apply README.md",
    "test": "node --test test/*.test.mjs",
    "test:affected": "node bin/affected-node-test.mjs affected",
    "test:baseline": "node bin/affected-node-test.mjs baseline",
    "test:since-last-run": "node bin/affected-node-test.mjs since-last-run",
    "test:watch": "node bin/affected-node-test.mjs watch",
    "test:unit": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "acorn": "8.19.0"
  },
  "devDependencies": {
    "mdcode-ts": "0.1.0"
  }
}
